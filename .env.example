# ========================================
# 🔧 PLANTILLA DE VARIABLES DE ENTORNO
# ========================================
# Copia este archivo como .env y completa los valores

# ========================================
# 🏗️ CONFIGURACIÓN DE AWS CDK
# ========================================
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1

# ========================================
# 🌐 CONFIGURACIÓN DE AWS
# ========================================
AWS_REGION=us-east-1

# ========================================
# 🗄️ CONFIGURACIÓN DE DYNAMODB
# ========================================
DYNAMODB_TABLE_DATA=softtek-data
DYNAMODB_TABLE_CACHE=softtek-cache

# ========================================
# 🔐 CONFIGURACIÓN DE COGNITO
# ========================================
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX    # Opcional - solo para testing local
COGNITO_USER_POOL_CLIENT_ID=client_id_aqui  # Opcional - solo para testing local

# ========================================
# 🚀 CONFIGURACIÓN DE AMBIENTE
# ========================================
NODE_ENV=development
STAGE=dev
FREE_TIER_MODE=true
CACHE_TTL_SECONDS=1800
LOG_LEVEL=info
